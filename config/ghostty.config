# ═══════════════════════════════════════════════════════════════
#  Ghostty Configuration — Adwaita Dark Theme
# ═══════════════════════════════════════════════════════════════

# ── Font ──────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 13
font-thicken = true
adjust-cell-height = 10%

# ── Window Appearance ─────────────────────────────────────────────
# background-opacity = 0.90
# background-blur-radius = 20
window-padding-x = 14
window-padding-y = 12

# ── Cursor ────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Scrollback ────────────────────────────────────────────────────
scrollback-limit = 10000

# ── Shell integration ─────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Theme ─────────────────────────────────────────────────────────
theme = "Adwaita Dark"

# ── Keybindings ───────────────────────────────────────────────────
# New tab
keybind = ctrl+t=new_tab

# Tab navigation
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5

# Split panes
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down

# Close surface (tab / split)
keybind = ctrl+w=close_surface

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Copy / paste
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Scroll
keybind = ctrl+shift+u=scroll_page_up
keybind = ctrl+shift+d=scroll_page_down

# Fullscreen
keybind = f11=toggle_fullscreen

# ── Miscellaneous ─────────────────────────────────────────────────
confirm-close-surface = false
mouse-hide-while-typing = true

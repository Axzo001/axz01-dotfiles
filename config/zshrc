# ── Autosuggestions Config ────────────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#2e5555,bold"
ZSH_AUTOSUGGEST_STRATEGY=(atuin history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

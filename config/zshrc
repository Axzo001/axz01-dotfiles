alias lta='eza --icons --group-directories-first --color=always --tree --level=3'
alias l='eza --icons --group-directories-first --color=always -1'
alias lsize='eza --icons --color=always -lah --sort=size'
alias lmod='eza --icons --color=always -lah --sort=modified'

# ── Aliases — Better Cat (bat) ────────────────────────────────────
alias cat='bat --paging=never'
alias catp='bat'

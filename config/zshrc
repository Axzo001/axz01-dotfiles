# ═══════════════════════════════════════════════════════════════
#  .zshrc — Teal Dark Glassmorphism Terminal Configuration
#  Palette: #0a0a0a bg │ #00b4d8 cyan │ #00e5a0 teal │ #4dffd2 mint
#  Requires: oh-my-zsh, starship, fzf, bat, eza, fd, rg, zoxide, atuin
# ═══════════════════════════════════════════════════════════════

# ── Oh My Zsh Core ────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Disabled: using Starship

# ── Additional completions (must be before compinit) ──────────────
fpath+="${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src"

# ── Plugins ───────────────────────────────────────────────────────
plugins=(
  # ── Version Control ───────────────────────────────────────────
  git
  github

  # ── Dev Languages & Tools ─────────────────────────────────────
  node
  npm
  python
  pip
  rust
  golang
  docker
  docker-compose

  # ── System & Productivity ─────────────────────────────────────
  sudo
  extract
  history
  copypath
  copyfile
  colored-man-pages
  command-not-found
  systemd
  encode64
  urltools
  web-search
  alias-finder
  dotenv

  # ── External Plugins (cloned via install script) ───────────────
  zsh-completions
  fzf-tab
  you-should-use
  zsh-autosuggestions
  zsh-history-substring-search
  zsh-syntax-highlighting     # ← MUST be last
)

source "$ZSH/oh-my-zsh.sh"

# ── Completion Engine ─────────────────────────────────────────────
autoload -Uz compinit
compinit -d "$HOME/.zcompdump-$ZSH_VERSION"

# Completion styling
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:*:*:*:processes' command 'ps -u $USER -o pid,user,comm -w'

# fzf-tab previews
zstyle ':fzf-tab:complete:cd:*'         fzf-preview 'eza --color=always --icons --group-directories-first $realpath 2>/dev/null'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza --color=always --icons --group-directories-first $realpath 2>/dev/null'
zstyle ':fzf-tab:complete:kill:argument-rest' fzf-preview '[[ $group == "[process ID]" ]] && ps --pid=$word -o cmd --no-header -w'
zstyle ':fzf-tab:*' fzf-flags \
  --height=50% --layout=reverse --border=rounded

# ── History Configuration ─────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY_TIME

# ── Shell Options ─────────────────────────────────────────────────
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_MINUS
setopt CORRECT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt GLOBDOTS
setopt EXTENDED_GLOB
setopt PIPE_FAIL

# ── Environment Variables ─────────────────────────────────────────
export EDITOR="zed --wait"
export VISUAL="$EDITOR"
export PAGER="bat --paging=always"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANROFFOPT="-c"
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Bat theme
export BAT_THEME="Dracula"

# FZF — Default colors
export FZF_DEFAULT_OPTS="
  --height=50%
  --layout=reverse
  --border=rounded
  --prompt='❯ '
  --pointer='▶'
  --marker='✓'
  --preview-window=border-rounded
"
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range :80 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --color=always --icons --tree --level=2 {} 2>/dev/null'"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:wrap"

# Cargo / Rust
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"


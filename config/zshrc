ZSH_HIGHLIGHT_STYLES[globbing]='fg=#4dffd2'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#a5d6a7'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#a5d6a7'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#80cbc4'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#00b4d8'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#4dffd2'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ef5350,bold'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#4a8080'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=#4dffd2'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=#4dffd2'

# ── You Should Use Config ─────────────────────────────────────────
export YSU_MESSAGE_POSITION="after"
export YSU_MODE=ALL

# ── History Substring Search Config ──────────────────────────────
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND="fg=#00e5a0,bold,underline"
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND="fg=#ef5350,bold"
HISTORY_SUBSTRING_SEARCH_GLOBBING_FLAGS="i"

# ── Keyboard Shortcuts ────────────────────────────────────────────
# History navigation with arrows and Ctrl+P/N
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^P'   history-substring-search-up
bindkey '^N'   history-substring-search-down

# Word navigation
bindkey '^[b' backward-word
bindkey '^[f' forward-word
bindkey '^[d' kill-word
bindkey '^W'  backward-kill-word

# Line navigation
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^K' kill-line
bindkey '^U' backward-kill-line

# Insert last word (Alt+.)
bindkey '^[.' insert-last-word

# Edit command in $EDITOR (Ctrl+X Ctrl+E)
autoload -z edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ── Tool Initializations ──────────────────────────────────────────
# Starship prompt (must come early, but after plugins)
eval "$(starship init zsh)"

# Zoxide — smart cd with frecency
eval "$(zoxide init zsh --cmd z)"

# Atuin — enhanced shell history (Ctrl+R for search)
if command -v atuin &>/dev/null; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# FZF — fuzzy finder keybindings & completions
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)
fi

# ── Helper Functions ──────────────────────────────────────────────
# mkcd: make directory and cd into it
mkcd() { mkdir -pv "$@" && cd "$_" || return; }

# up: go up N directories
up() {
  local d=""
  local limit="${1:-1}"
  for (( i=1; i <= limit; i++ )); do d="../$d"; done
  cd "$d" || return
}

# extract: universal archive extractor (backup if extract plugin fails)
extract_file() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"   ;;
      *.tar.gz)    tar xzf "$1"   ;;
      *.tar.xz)    tar xJf "$1"   ;;
      *.bz2)       bunzip2 "$1"   ;;
      *.rar)       unrar x "$1"   ;;
      *.gz)        gunzip "$1"    ;;
      *.tar)       tar xf "$1"    ;;
      *.tbz2)      tar xjf "$1"   ;;
      *.tgz)       tar xzf "$1"   ;;
      *.zip)       unzip "$1"     ;;
      *.Z)         uncompress "$1";;
      *.7z)        7z x "$1"      ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# fzf-powered history search function
fh() {
  eval "$(history | fzf --tac --no-sort | sed 's/ *[0-9]* *//')"
}

# Quick git add all and commit with message
gac() { git add -A && git commit -m "$*"; }

# Preview files with bat + fzf
preview() {
  fzf --preview 'bat --color=always --style=numbers {}' \
      --preview-window='right:60%' \
      --bind='enter:execute(bat --paging=always {})'
}

# ── Greeting — Show fastfetch on new session ───────────────────────
fastfetch
